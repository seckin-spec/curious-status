# ── Infra Status Dashboard — API tokens ───────────────────────────────
# Copy this file to ".env" (same folder) and paste your READ-ONLY tokens.
# Leave any line blank to skip that platform — the dashboard just shows it
# as "not connected". Never commit the real .env.

# NETLIFY ─ Personal access token
#   app.netlify.com → User settings → Applications → Personal access tokens
#   → "New access token". Read access is enough.
NETLIFY_TOKEN=

# SUPABASE ─ Management API access token (NOT a project anon/service key)
#   supabase.com/dashboard → Account → Access Tokens → "Generate new token"
SUPABASE_TOKEN=

# RESEND ─ API key (read-only "Sending access" is fine)
#   resend.com/api-keys → "Create API Key" → Permission: Full access or Read
RESEND_TOKEN=
